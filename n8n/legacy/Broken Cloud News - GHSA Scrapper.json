    {
      "parameters": {
        "options": {}
      },
      "id": "97b2ad79-e53f-48a0-b4e2-f392bd3f0d71",
      "name": "Loop (1 by 1)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1184,
        -240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://browserless:3000/scrape?token=secure_browser_token",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"url\": \"{{ $json.url }}\",\n  \"elements\": [\n    {\n      \"selector\": \".markdown-body\" \n    },\n    {\n      \"selector\": \"article\"\n    },\n    {\n      \"selector\": \"body\"\n    }\n  ],\n  \"waitFor\": 3000\n}",
        "options": {}
      },
      "id": "3572c19a-6ccf-4fea-81de-e70b3a0b4c7d",
      "name": "Browserless Scrape",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1392,
        -240
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE github_security_advisories \nSET raw_content = $1, status = 'SCRAPED' \nWHERE id = $2;",
        "options": {
          "queryReplacement": "={{ ($json.data[0].results[0] ? $json.data[0].results[0].text : '') || ($json.data[1].results[0] ? $json.data[1].results[0].text : '') || ($json.data[2].results[0] ? $json.data[2].results[0].text : 'NO CONTENT') }}, {{ $('Loop (1 by 1)').context[\"currentRunIndex\"] === 0 ? $('Loop (1 by 1)').first().json.id : $('Loop (1 by 1)').item.json.id }}"
        }
      },
      "id": "f0199937-e488-4977-8f8a-199fd691bfc8",
      "name": "DB: Save Content",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [
        1584,
        -240
      ],
      "credentials": {
        "postgres": {
          "id": "Ydz06IeiT4MhtHI0",
          "name": "Postgres account"
        }
      }
    },
    {
