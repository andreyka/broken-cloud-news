        "query": "SELECT id, url FROM github_security_advisories WHERE status = 'NEW' LIMIT 5;",
        "options": {}
      },
      "id": "ac5d51b1-2d20-44e6-a4be-6eaf1794eec7",
      "name": "DB: Get NEW Items",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
