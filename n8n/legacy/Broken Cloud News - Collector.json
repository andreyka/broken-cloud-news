    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Safety: Check if input exists\nif (!items.length || !items[0].json) return [];\n\n// Safety: Handle API errors\nif (items[0].json.message) throw new Error(\"GitHub API Error: \" + items[0].json.message);\n\n// Safety: Handle nested data structure (n8n v1 vs v2)\nconst root = items[0].json.data || items[0].json;\nif (!root || !root.securityAdvisories || !root.securityAdvisories.nodes) return [];\n\nconst advisories = root.securityAdvisories.nodes;\nconst allowedSeverities = [\"CRITICAL\", \"HIGH\"];\nconst keywords = [\n  /kubernetes/i, /k8s/i, /docker/i, /container/i, /aws/i, /azure/i, /gcp/i, \n  /cloud/i, /terraform/i, /iam/i, /serverless/i, /vmware/i, /openstack/i\n];\n\nconst filtered = advisories.filter(item => {\n  if (!allowedSeverities.includes(item.severity)) return false;\n  const text = (item.summary + \" \" + item.description).toLowerCase();\n  return keywords.some(regex => regex.test(text));\n});\n\nreturn filtered.map(item => {\n  const refs = item.references.map(r => r.url);\n  // Prefer external blogs over github.com links\n  const externalLink = refs.find(url => !url.includes(\"github.com\") && !url.includes(\"nist.gov\")) || item.permalink;\n\n  return {\n    json: {\n      ghsa_id: item.ghsaId,\n      title: item.summary,\n      severity: item.severity,\n      url: externalLink,\n      source: 'github',\n      status: 'NEW'\n    }\n  };\n});"
      },
