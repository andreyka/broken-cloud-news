{
    "name": "Distributor - Daily Digest",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "days",
                            "daysInterval": 1
                        }
                    ],
                    "time": [
                        {
                            "hour": 9,
                            "minute": 0
                        }
                    ]
                }
            },
            "id": "schedule-trigger",
            "name": "Every Day at 9am",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT * FROM news_items WHERE status = 'ANALYZED' AND juiciness_score >= 7 AND published_at > NOW() - INTERVAL '24 HOURS';",
                "options": {}
            },
            "id": "get-analyzed",
            "name": "DB: Get Analyzed",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.2,
            "position": [
                220,
                0
            ],
            "credentials": {
                "postgres": {
                    "id": "postgres_creds",
                    "name": "Postgres"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "const items = $input.all().map(i => i.json);\nif (items.length === 0) return [];\n\nlet markdown = \"# 🌩️ Broken Cloud News Digest\\n\\n\";\n\nitems.forEach(item => {\n  markdown += `### [${item.title}](${item.url})\\n`;\n  markdown += `**Score:** ${item.juiciness_score}/10 | **Source:** ${item.source_type}\\n`;\n  markdown += `${item.summary}\\n\\n`;\n});\n\nmarkdown += \"---\\n*Generated by Broken Cloud News Agent* 🤖\";\n\nreturn { json: { markdown: markdown, count: items.length } };"
            },
            "id": "format-digest",
            "name": "Format Digest",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                440,
                0
            ]
        },
        {
            "parameters": {
                "chatId": "YOUR_CHAT_ID",
                "text": "={{ $json.markdown }}",
                "additionalFields": {
                    "parse_mode": "Markdown"
                }
            },
            "id": "telegram-send",
            "name": "Telegram (Placeholder)",
            "type": "n8n-nodes-base.telegram",
            "typeVersion": 1.1,
            "position": [
                660,
                -100
            ],
            "credentials": {
                "telegramApi": {
                    "id": "telegram_creds",
                    "name": "Telegram"
                }
            }
        },
        {
            "parameters": {
                "channel": "cloud-security-news",
                "text": "={{ $json.markdown }}",
                "otherOptions": {}
            },
            "id": "slack-send",
            "name": "Slack (Placeholder)",
            "type": "n8n-nodes-base.slack",
            "typeVersion": 2,
            "position": [
                660,
                100
            ],
            "credentials": {
                "slackApi": {
                    "id": "slack_creds",
                    "name": "Slack"
                }
            }
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "UPDATE news_items SET status = 'PUBLISHED' WHERE status = 'ANALYZED' AND juiciness_score >= 7 AND published_at > NOW() - INTERVAL '24 HOURS';",
                "options": {}
            },
            "id": "update-db-published",
            "name": "Mark Published",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.2,
            "position": [
                880,
                0
            ],
            "credentials": {
                "postgres": {
                    "id": "postgres_creds",
                    "name": "Postgres"
                }
            }
        }
    ],
    "connections": {
        "Every Day at 9am": {
            "main": [
                [
                    {
                        "node": "DB: Get Analyzed",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "DB: Get Analyzed": {
            "main": [
                [
                    {
                        "node": "Format Digest",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Format Digest": {
            "main": [
                [
                    {
                        "node": "Telegram (Placeholder)",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "Slack (Placeholder)",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "Mark Published",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}