{
    "name": "Collector - X (Apify)",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "hours",
                            "hoursInterval": 6
                        }
                    ]
                }
            },
            "id": "schedule-trigger",
            "name": "Every 6 Hours",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://api.apify.com/v2/acts/apidojo~twitter-scraper-lite/run-sync-get-dataset-items",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpBearerAuth",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "{\n  \"twitterHandles\": [\"GoogleVRP\", \"HackingLZ\", \"anton_chuvakin\", \"AISecHub\", \"_JohnHammond\", \"lauriewired\", \"chompie1337\", \"Steph3nSims\", \"d0znpp\", \"KimZetter\", \"argvee\", \"avkovaleff\", \"tom_doerr\"],\n  \"maxItems\": 20\n}",
                "options": {}
            },
            "id": "apify-request",
            "name": "Apify: Tweet Scraper",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                220,
                0
            ],
            "credentials": {
                "httpBearerAuth": {
                    "id": "apify_api_token",
                    "name": "Apify Token"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "return $input.all().map(item => {\n  const i = item.json;\n  return {\n    json: {\n      source_type: 'twitter',\n      source_id: i.id || i.conversationId,\n      url: i.url || i.twitterUrl,\n      title: i.text || i.fullText,\n      published_at: i.createdAt || i.date,\n      raw_data: i,\n      status: 'NEW'\n    }\n  };\n});"
            },
            "id": "normalize-twitter",
            "name": "Normalize X",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                440,
                0
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "INSERT INTO news_items (source_type, source_id, url, title, published_at, raw_data, status)\nVALUES ($1, $2, $3, $4, $5, $6, 'NEW')\nON CONFLICT (source_type, source_id) DO NOTHING;",
                "options": {
                    "queryReplacement": "={{ $json.source_type }}, {{ $json.source_id }}, {{ $json.url }}, {{ $json.title }}, {{ $json.published_at }}, {{ JSON.stringify($json.raw_data) }}"
                }
            },
            "id": "postgres-insert",
            "name": "Save to DB",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.2,
            "position": [
                660,
                0
            ],
            "credentials": {
                "postgres": {
                    "id": "postgres_creds",
                    "name": "Postgres"
                }
            }
        }
    ],
    "connections": {
        "Every 6 Hours": {
            "main": [
                [
                    {
                        "node": "Apify: Tweet Scraper",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Apify: Tweet Scraper": {
            "main": [
                [
                    {
                        "node": "Normalize X",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Normalize X": {
            "main": [
                [
                    {
                        "node": "Save to DB",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}