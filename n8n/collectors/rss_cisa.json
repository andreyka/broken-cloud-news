{
    "name": "Collector - RSS Feeds",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "hours",
                            "hoursInterval": 2
                        }
                    ]
                }
            },
            "id": "schedule-trigger",
            "name": "Every 2 Hours",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "url": "https://www.cisa.gov/cybersecurity-advisories/all.xml"
            },
            "id": "rss-cisa",
            "name": "RSS: CISA",
            "type": "n8n-nodes-base.rssFeedRead",
            "typeVersion": 1.1,
            "position": [
                220,
                -100
            ]
        },
        {
            "parameters": {
                "url": "https://aws.amazon.com/blogs/security/feed/"
            },
            "id": "rss-aws",
            "name": "RSS: AWS",
            "type": "n8n-nodes-base.rssFeedRead",
            "typeVersion": 1.1,
            "position": [
                220,
                100
            ]
        },
        {
            "parameters": {
                "jsCode": "return $input.all().map(item => {\n  const i = item.json;\n  return {\n    json: {\n      source_type: 'rss',\n      source_id: i.guid || i.link,\n      url: i.link,\n      title: i.title,\n      published_at: i.isoDate || new Date().toISOString(),\n      raw_data: i,\n      status: 'NEW'\n    }\n  };\n});"
            },
            "id": "normalize-rss",
            "name": "Normalize RSS",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                440,
                0
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "INSERT INTO news_items (source_type, source_id, url, title, published_at, raw_data, status)\nVALUES ($1, $2, $3, $4, $5, $6, 'NEW')\nON CONFLICT (source_type, source_id) DO NOTHING;",
                "options": {
                    "queryReplacement": "={{ $json.source_type }}, {{ $json.source_id }}, {{ $json.url }}, {{ $json.title }}, {{ $json.published_at }}, {{ JSON.stringify($json.raw_data) }}"
                }
            },
            "id": "postgres-insert",
            "name": "Save to DB",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.2,
            "position": [
                660,
                0
            ],
            "credentials": {
                "postgres": {
                    "id": "postgres_creds",
                    "name": "Postgres"
                }
            }
        }
    ],
    "connections": {
        "Every 2 Hours": {
            "main": [
                [
                    {
                        "node": "RSS: CISA",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "RSS: AWS",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "RSS: CISA": {
            "main": [
                [
                    {
                        "node": "Normalize RSS",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "RSS: AWS": {
            "main": [
                [
                    {
                        "node": "Normalize RSS",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Normalize RSS": {
            "main": [
                [
                    {
                        "node": "Save to DB",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}