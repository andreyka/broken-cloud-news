{
    "name": "Scraper - Browserless",
    "nodes": [
        {
            "parameters": {},
            "id": "execute-trigger",
            "name": "Execute Workflow",
            "type": "n8n-nodes-base.executeWorkflowTrigger",
            "typeVersion": 1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "http://browserless:3000/scrape?token=secure_browser_token",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"url\": \"{{ $json.url }}\",\n  \"elements\": [\n    { \"selector\": \"article\" },\n    { \"selector\": \".markdown-body\" },\n    { \"selector\": \"main\" },\n    { \"selector\": \"body\" }\n  ],\n  \"waitFor\": 2000\n}",
                "options": {}
            },
            "id": "browserless-req",
            "name": "Browserless",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                220,
                0
            ]
        },
        {
            "parameters": {
                "jsCode": "const data = $input.first().json;\nconst results = data.data || [];\n// Try to find the best content match\nconst bestMatch = results.find(r => r.results && r.results.length > 0 && r.results[0].text.length > 100) || \n                  results[results.length - 1]; // Fallback to body\n\nconst content = bestMatch && bestMatch.results && bestMatch.results[0] ? bestMatch.results[0].text : 'NO_CONTENT';\n\nreturn { \n  json: { \n    ...$json, \n    full_content: content.substring(0, 10000) // Limit size\n  } \n};"
            },
            "id": "parse-scrape",
            "name": "Parse Content",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                440,
                0
            ]
        }
    ],
    "connections": {
        "Execute Workflow": {
            "main": [
                [
                    {
                        "node": "Browserless",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Browserless": {
            "main": [
                [
                    {
                        "node": "Parse Content",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}