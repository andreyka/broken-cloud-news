            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT * FROM news_items WHERE status = 'NEW';",
                "options": {}
            },
            "id": "get-new-items",
            "name": "DB: Get NEW",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.2,
            "position": [
                220,
                0
            ],
            "credentials": {
                "postgres": {
                    "id": "postgres_creds",
                    "name": "Postgres"
                }
            }
        },
        {
            "parameters": {
                "options": {}
            },
            "id": "split-batch",
            "name": "Loop Items",
            "type": "n8n-nodes-base.splitInBatches",
            "typeVersion": 3,
            "position": [
                440,
                0
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{ $json.source_type }}",
                            "operation": "equal",
                            "value2": "rss"
                        }
                    ]
                }
            },
            "id": "check-source",
            "name": "Is RSS?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                660,
                0
            ]
        },
        {
            "parameters": {
                "workflowId": "scraper-browserless"
            },
            "id": "call-scraper",
            "name": "Call Scraper",
            "type": "n8n-nodes-base.executeWorkflow",
            "typeVersion": 1,
            "position": [
                880,
                -100
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "http://host.docker.internal:8000/v1/chat/completions",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ {\n  \"model\": \"Qwen/Qwen3-VL-30B-A3B-Instruct-FP8\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a Senior Cloud Security Engineer curating the 'Broken Cloud' daily security brief. Your goal is to identify practical, hands-on security content while filtering out marketing fluff and theoretical chatter.\\n\\nAnalyze the following content and return JSON with:\\n1. summary: A concise, technical summary (2-3 sentences) focusing on the 'so what?' for a practitioner.\\n2. juiciness_score: 1-10. High (8-10) for exploits, POCs, novel attacks, or tools. Low (1-4) for marketing/policy.\\n3. tags: Array of 3-5 technical tags.\\n4. image_prompt: A creative, eye-catching image prompt for an AI art generator. Abstractly represent the core technical concept (e.g., cyberpunk server room, glowing digital shield). Avoid text. Make it dramatic and high contrast.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Title: \" + $json.title + \"\\n\\nContent: \" + ($json.full_content || $json.title)\n    }\n  ]\n} }}",
                "options": {}
            },
            "id": "llm-analyze",
            "name": "LLM Analyze (Qwen-VL)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                1100,
                0
            ]
        },
        {
            "parameters": {
                "jsCode": "const llm = $input.first().json.choices[0].message.content;\nlet parsed = {};\ntry {\n  parsed = JSON.parse(llm.replace(/```json/g, '').replace(/```/g, ''));\n} catch (e) {\n  parsed = { summary: llm, juiciness_score: 5, tags: [], image_prompt: 'cloud security concept art' };\n}\n\nreturn { \n  json: { \n    ...$('Loop Items').item.json, \n    summary: parsed.summary,\n    juiciness_score: parsed.juiciness_score,\n    ai_tags: parsed.tags,\n    image_prompt: parsed.image_prompt,\n    status: 'ANALYZED'\n  } \n};"
            },
            "id": "parse-llm",
            "name": "Parse LLM",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1280,
                0
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "UPDATE news_items SET summary = $1, juiciness_score = $2, ai_tags = $3, status = 'ANALYZED', full_content = $4, image_prompt = $5, image_url = $6 WHERE id = $7;",
                "options": {
                    "queryReplacement": "={{ $json.summary }}, {{ $json.juiciness_score }}, {{ JSON.stringify($json.ai_tags) }}, {{ $json.full_content || null }}, {{ $json.image_prompt || null }}, {{ null }}, {{ $json.id }}"
                }
            },
            "id": "update-db",
            "name": "Save Analysis",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.2,
            "position": [
                1540,
                0
            ],
            "credentials": {
                "postgres": {
                    "id": "postgres_creds",
                    "name": "Postgres"
                }
            }
        }
    ],
