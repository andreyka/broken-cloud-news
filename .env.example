# BCN_WORKFLOW_JOB_PUBLISH_RETRY_BASE_DELAY_SECONDS=30
# BCN_WORKFLOW_JOB_PUBLISH_RETRY_MAX_DELAY_SECONDS=300
# BCN_WORKFLOW_JOB_COLLECTION_RETRY_BASE_DELAY_SECONDS=120
# BCN_WORKFLOW_JOB_COLLECTION_RETRY_MAX_DELAY_SECONDS=1800
# BCN_WORKFLOW_JOB_ANALYSIS_RETRY_BASE_DELAY_SECONDS=120
# BCN_WORKFLOW_JOB_ANALYSIS_RETRY_MAX_DELAY_SECONDS=1800
# BCN_WORKFLOW_JOB_EVALUATION_RETRY_BASE_DELAY_SECONDS=300
# BCN_WORKFLOW_JOB_EVALUATION_RETRY_MAX_DELAY_SECONDS=3600
# BCN_COLLECTOR_SERVICE_URL=http://collector.internal:8084
# BCN_ANALYST_SERVICE_URL=http://analyst.internal:8085
# BCN_WRITER_SERVICE_URL=http://writer.internal:8081
# BCN_DISTRIBUTOR_SERVICE_URL=http://distributor.internal:8086
