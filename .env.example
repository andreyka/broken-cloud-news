# Broken Cloud News - Configuration
# Copy to .env and fill in your values

# Database mode for setup.sh: docker | managed
BCN_SETUP_DATABASE_MODE=docker
# Docker mode default (inside container host must be "postgres")
BCN_POSTGRES_USER=postgres
BCN_POSTGRES_PASSWORD=postgres
BCN_POSTGRES_DB=broken_cloud_news
BCN_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/broken_cloud_news
# Managed DB example:
# BCN_DATABASE_URL=postgresql://user:password@db.example.com:5432/broken_cloud_news?sslmode=require

# LLM endpoint (OpenAI-compatible example)
BCN_LLM_PROVIDER=openai_compat
BCN_LLM_BASE_URL=http://localhost:8000/v1
BCN_LLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
BCN_LLM_API_KEY=
# BCN_LLM_TIMEOUT=180
# BCN_LLM_CHAT_RETRIES=16
# BCN_LLM_RETRY_MAX_WAIT_SECONDS=600
# BCN_LLM_RETRY_JITTER_MIN_SECONDS=0.5
# BCN_LLM_RETRY_JITTER_MAX_SECONDS=5.0

# Optional per-role overrides (empty = fallback to BCN_LLM_*)
# BCN_LLM_MODEL_ANALYST=gpt-5-mini
# BCN_LLM_MODEL_WRITER=gemini-3.1-pro-preview
# BCN_LLM_MODEL_CRITIC=gemini-3.1-pro-preview
# BCN_LLM_MODEL_VERIFIER=gemini-3.1-pro-preview
# BCN_LLM_MODEL_COVER=imagen-3.0-generate-002
# Optional if your Vertex project has access and the right global endpoint setup:
# BCN_LLM_MODEL_COVER=gemini-3-pro-image-preview
# BCN_LLM_PROVIDER_ANALYST=vertexai
# BCN_LLM_PROVIDER_WRITER=vertexai
# BCN_LLM_PROVIDER_CRITIC=vertexai
# BCN_LLM_PROVIDER_VERIFIER=vertexai
# BCN_LLM_PROVIDER_COVER=vertexai
# BCN_LLM_BASE_URL_ANALYST=https://aiplatform.googleapis.com/v1
# BCN_LLM_BASE_URL_WRITER=https://aiplatform.googleapis.com/v1
# BCN_LLM_BASE_URL_CRITIC=https://aiplatform.googleapis.com/v1
# BCN_LLM_BASE_URL_VERIFIER=https://aiplatform.googleapis.com/v1
# BCN_LLM_BASE_URL_COVER=https://aiplatform.googleapis.com/v1
# BCN_LLM_API_KEY_ANALYST=<api-key>
# BCN_LLM_API_KEY_WRITER=<api-key>
# BCN_LLM_API_KEY_CRITIC=<api-key>
# BCN_LLM_API_KEY_VERIFIER=<api-key>
# BCN_LLM_API_KEY_COVER=<api-key>
# Optional reasoning effort for OpenAI reasoning models (ignored for other backends)
# BCN_LLM_REASONING_EFFORT=medium
# BCN_LLM_REASONING_EFFORT_WRITER=xhigh
# BCN_LLM_REASONING_EFFORT_CRITIC=high
# Optional analyst-specific throughput guardrails
# BCN_LLM_TIMEOUT_ANALYST=60
# BCN_LLM_CHAT_RETRIES_ANALYST=4
# BCN_LLM_RETRY_MAX_WAIT_SECONDS_ANALYST=45
# BCN_LLM_RETRY_JITTER_MIN_SECONDS_ANALYST=0.5
# BCN_LLM_RETRY_JITTER_MAX_SECONDS_ANALYST=2.0

# Optional AI review workflow for the dashboard review lab
# Falls back to OPENAI_API_KEY if BCN_AI_REVIEW_API_KEY is unset
# BCN_AI_REVIEW_API_KEY=<openai-api-key>
# BCN_AI_REVIEW_BASE_URL=https://api.openai.com/v1
# BCN_AI_REVIEW_MODEL=gpt-5.4
# BCN_AI_REVIEW_REASONING_EFFORT=high
# BCN_AI_REVIEW_TIMEOUT_SECONDS=180
# BCN_AI_REVIEW_AUTO_ENABLED=true
# BCN_AI_REVIEW_PUBLISH_GATE_ENABLED=false
# BCN_AI_REVIEW_BACKFILL_ENABLED=true
# BCN_AI_REVIEW_BACKFILL_WEEKDAY=sun
# BCN_AI_REVIEW_BACKFILL_HOUR=4
# BCN_AI_REVIEW_BACKFILL_MINUTE=0
# BCN_AI_REVIEW_BACKFILL_TIMEZONE=UTC
# BCN_AI_REVIEW_BACKFILL_MAX_BRIEFINGS=25

# ComfyUI endpoint as seen by the app containers
BCN_COMFYUI_URL=http://comfy_bridge:8188
# If the Docker `comfy_bridge` service proxies a host/local ComfyUI instance, set:
# COMFYUI_BRIDGE_UPSTREAM=http://host.docker.internal:8188
# If the Docker `model_bridge` service proxies a host-local model, set:
# MODEL_BRIDGE_UPSTREAM=http://host.docker.internal:8000

# GitHub API token (for GHSA collection)
BCN_GITHUB_TOKEN=<github-token>

# X API Bearer Token (for Twitter/X collection)
BCN_TWITTER_BEARER_TOKEN=<x-bearer-token>

# Telegram distribution
BCN_TELEGRAM_BOT_TOKEN=<telegram-bot-token>
BCN_TELEGRAM_CHAT_ID=-1001234567890

# Operator alerts (publish failures, quiet-day streaks) to a PRIVATE chat.
# Never points at the public channel. Run `bcn smoke` after every deploy.
# BCN_ALERTS_ENABLED=true
# BCN_ALERT_TELEGRAM_CHAT_ID=<your-private-chat-id>
# BCN_ALERT_QUIET_STREAK_THRESHOLD=4

# Discord distribution
BCN_DISCORD_BOT_TOKEN=
BCN_DISCORD_CHANNEL_ID=

# Model bridge challenger upstream
MODEL_BRIDGE_UPSTREAM=http://host.docker.internal:8000

# Ghost distribution (Admin API key required for publishing)
BCN_GHOST_ENABLED=false
BCN_GHOST_ADMIN_API_URL=https://yourpub.ghost.io
BCN_GHOST_ADMIN_API_KEY=

# Substack distribution
BCN_SUBSTACK_ENABLED=false
BCN_SUBSTACK_SID=
BCN_SUBSTACK_PUBLICATION_URL=https://yourpub.substack.com

# Email distribution (SMTP)
BCN_SMTP_HOST=smtp.gmail.com
BCN_SMTP_PORT=587
BCN_SMTP_USER=you@gmail.com
BCN_SMTP_PASSWORD=app-password-here
BCN_EMAIL_FROM=Broken Cloud News <you@gmail.com>
BCN_EMAIL_RECIPIENTS=["team@example.com"]
# Monthly newsletter subscribers are stored in DB:
# bcn newsletter-subscribers add you@example.com

# Slack distribution (webhook)
BCN_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/xxxx

# Scheduling (defaults shown)
# BCN_GHSA_INTERVAL_HOURS=4
# BCN_RSS_INTERVAL_HOURS=2
# BCN_REDDIT_INTERVAL_HOURS=3
# BCN_TWITTER_INTERVAL_HOURS=6
# BCN_ANALYST_INTERVAL_MINUTES=15
# BCN_DISTRIBUTE_HOUR=9
# BCN_DISTRIBUTE_HOURS=9,13,19
# BCN_DISTRIBUTE_MINUTE=0
# BCN_DISTRIBUTE_TIMEZONE=UTC
# Weekly flagship edition: generated on schedule, HELD for human review.
# Approve with `bcn flagship-approve`; goes to substack/ghost/email only.
# BCN_WEEKLY_FLAGSHIP_ENABLED=true
# BCN_WEEKLY_FLAGSHIP_DAY_OF_WEEK=thu
# BCN_WEEKLY_FLAGSHIP_HOUR=16
# BCN_WEEKLY_FLAGSHIP_TIMEZONE=UTC
# BCN_WEEKLY_FLAGSHIP_LOOKBACK_DAYS=7
# BCN_WEEKLY_FLAGSHIP_MIN_SCORE=7
# BCN_WEEKLY_FLAGSHIP_MIN_ITEMS=5
# BCN_WEEKLY_FLAGSHIP_MAX_ITEMS=10
# BCN_MONTHLY_NEWSLETTER_ENABLED=true
# BCN_MONTHLY_NEWSLETTER_DAY=1
# BCN_MONTHLY_NEWSLETTER_HOUR=9
# BCN_MONTHLY_NEWSLETTER_MINUTE=0
# BCN_MONTHLY_NEWSLETTER_TIMEZONE=UTC
# BCN_SHADOW_ENABLED=true
# BCN_SHADOW_MINUTES_BEFORE_PUBLISH=45
# BCN_SHADOW_CANDIDATE_OVERRIDES_PATH=/app/bcn/config/shadow_nemotron_bridge.json
# BCN_SHADOW_INCLUDE_TEXT=true
# BCN_SERVICE_REQUEST_TIMEOUT_SECONDS=900
# BCN_SERVICE_AUTH_TOKEN=<shared-internal-token>
# BCN_GENERATION_RUN_STALE_PENDING_MINUTES=180
# BCN_ANALYSIS_RETRY_MAX_ATTEMPTS=5
# BCN_ANALYSIS_RETRY_BASE_DELAY_SECONDS=300
# BCN_ANALYSIS_RETRY_MAX_DELAY_SECONDS=7200
# BCN_ANALYSIS_RETRY_STALE_ANALYZING_MINUTES=120
# BCN_WORKFLOW_JOB_POLL_INTERVAL_SECONDS=5
# BCN_WORKFLOW_JOB_LEASE_REFRESH_SECONDS=60
# BCN_WORKFLOW_JOB_DEFAULT_LEASE_SECONDS=900
# BCN_WORKFLOW_JOB_PUBLISH_LEASE_SECONDS=1200
