{{!< default}}

{{#post}}
<article class="post-shell {{post_class}}">
    <header class="post-hero">
        <div class="post-hero-copy">
            <p class="eyebrow">Broken Cloud Update</p>
            <h1>{{title}}</h1>
            {{#if custom_excerpt}}
                <p class="post-dek">{{custom_excerpt}}</p>
            {{/if}}
            <div class="post-meta">
                <span>{{date format="MMM D, YYYY"}}</span>
                <span>{{reading_time minute=(t "1 min read") minutes=(t "% min read")}}</span>
                {{#if primary_author}}
                    <span>{{primary_author.name}}</span>
                {{/if}}
            </div>
        </div>
        {{#if feature_image}}
            <figure class="post-cover-frame">
                <img class="post-cover" src="{{feature_image}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
            </figure>
        {{/if}}
    </header>

    <div class="post-content kg-content">
        {{content}}
    </div>
</article>
{{/post}}
